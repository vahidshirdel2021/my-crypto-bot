TELEGRAM_TOKEN=YOUR_BOT_TOKEN
PORT=10000
BOT_DB_PATH=trader_bot.sqlite3
SCAN_INTERVAL_SECONDS=45
DATA_CACHE_SECONDS=20
MAX_ASYNC_REQUESTS=10
DAILY_LOSS_LIMIT_PCT=3
RISK_PER_TRADE_PCT=0.5
MAX_MARGIN_USAGE_PCT=50
REAL_RESTART_LOCK=true
# Optional access whitelist. Empty = all Telegram users can use PAPER.
ALLOWED_CHAT_IDS=123456789,987654321

# Multi-user CoinEx accounts. Each Telegram chat_id gets its own API credentials.
# NEVER commit this file or expose it publicly.
COINEX_ACCOUNTS_JSON={"123456789":{"apiKey":"USER_A_KEY","secret":"USER_A_SECRET"},"987654321":{"apiKey":"USER_B_KEY","secret":"USER_B_SECRET"}}
