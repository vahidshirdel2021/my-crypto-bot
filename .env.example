TELEGRAM_TOKEN=
COINEX_ACCOUNTS_JSON=
ALLOWED_CHAT_IDS=
TELEGRAM_SKIP_BACKLOG=true
# فاصله زمانی گزارش تشخیصی عدم ورود (ثانیه) — پیش‌فرض ۳۰ دقیقه
NO_ENTRY_REPORT_SECONDS=1800
# حداقل ADX برای تشخیص قطعی جهت بازار (استراتژی Dynamic خودکار Long/Short)
MARKET_REGIME_MIN_ADX=22
# تایم‌فریمی که BTC/ETH روی آن برای تشخیص جهت قطعی بازار بررسی می‌شوند
MARKET_REGIME_TIMEFRAME=4hour
# کارمزد Taker هر طرف معامله (درصد) — برای محاسبه هزینه تخمینی رفت‌وبرگشت در PnL
TAKER_FEE_PCT=0.05

# فاز تست: ALLOWED_CHAT_IDS اختیاری است؛ در صورت مقداردهی فقط همان Chat IDها مجازند. برای REAL بهتر است whitelist تنظیم شود.
