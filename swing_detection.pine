//@version=5
// =====================================================================
// Swing Detection Suite — Pine Script v5 companion to swing_detection.py
// =====================================================================
// Implements the same three swing methodologies as the Python library:
//   1) Three-Bar Rejection / Wick Swing
//   2) Classic Three-Bar Extremity Swing (fractal)
//   3) Market Structure (BOS / ChoCH)
// Plus dynamic SL/TP levels drawn from the active swing.
//
// NOTE: This script mirrors the Python logic candle-for-candle so that
// backtests (Python) and chart visuals (TradingView) agree. It repaints
// only in the sense every swing-based indicator does: a pivot is not
// known until its confirmation bar has closed (no future data is used).
// =====================================================================

indicator("Swing Detection Suite (Rejection / Classic / Structure)", overlay = true, max_lines_count = 300, max_labels_count = 300)

// ---------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------
grp1 = "Three-Bar Rejection (Wick) Swing"
showRejection   = input.bool(true, "Show Rejection Swings", group = grp1)
maxBodyRatio    = input.float(0.5, "Max body ratio (wick dominance)", minval = 0.05, maxval = 1.0, step = 0.05, group = grp1)
strictConfirm   = input.bool(true, "Require full-body confirmation (C3)", group = grp1)

grp2 = "Classic Three-Bar Swing"
showClassic     = input.bool(true, "Show Classic Swings", group = grp2)
strictClassic   = input.bool(true, "Strict (no equal-price ties)", group = grp2)

grp3 = "Market Structure (BOS / ChoCH)"
showStructure   = input.bool(true, "Show BOS / ChoCH", group = grp3)
bodyCloseBreak  = input.bool(true, "Confirm structure break by body close (else wick)", group = grp3)
pivotSourceIsClassic = input.bool(true, "Use Classic swings as structure pivots (else Rejection)", group = grp3)

grp4 = "Risk Management"
showRisk        = input.bool(true, "Draw SL / TP from latest swing", group = grp4)
atrPeriod       = input.int(14, "ATR period", minval = 1, group = grp4)
atrBufferMult   = input.float(0.25, "ATR buffer multiplier", minval = 0.0, step = 0.05, group = grp4)
pctBuffer       = input.float(0.15, "Percent buffer (% of price)", minval = 0.0, step = 0.05, group = grp4) / 100.0
riskReward      = input.float(2.0, "Risk:Reward multiple for TP", minval = 0.1, step = 0.1, group = grp4)

// ---------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------
bodyTop    = math.max(open, close)
bodyBottom = math.min(open, close)
bodySize   = bodyTop - bodyBottom
atrVal     = ta.atr(atrPeriod)

// =======================================================================
// 1) THREE-BAR REJECTION / WICK SWING  (evaluated on the MIDDLE bar, i.e.
//    we look back 1 bar for the candle being classified, using bar[0] as
//    the confirmation candle -- mirrors the Python 3-bar window exactly)
// =======================================================================
c1_high = high[2], c1_low = low[2], c1_open = open[2], c1_close = close[2]
c2_high = high[1], c2_low = low[1], c2_open = open[1], c2_close = close[1]
c3_open = open,    c3_close = close

c1_body = math.abs(c1_close - c1_open)
c2_body = math.abs(c2_close - c2_open)
c3_body = math.abs(c3_close - c3_open)
c2_range = c2_high - c2_low
c2_bodyTop = math.max(c2_open, c2_close)
c2_bodyBottom = math.min(c2_open, c2_close)
bodyRef = math.max(math.max(c1_body, c3_body), 0.0000001)

isSwingLow2  = c2_low  < c1_low  and c2_low  < low
isSwingHigh2 = c2_high > c1_high and c2_high > high

rejWickDominated = c2_body <= maxBodyRatio * math.max(bodyRef, c2_range)

rejLowConfirmed  = strictConfirm ? (math.min(c3_open, c3_close) > c2_bodyTop) : (c3_close > c2_bodyTop)
rejHighConfirmed = strictConfirm ? (math.max(c3_open, c3_close) < c2_bodyBottom) : (c3_close < c2_bodyBottom)

rejectionSwingLow  = showRejection and isSwingLow2  and rejWickDominated and rejLowConfirmed
rejectionSwingHigh = showRejection and isSwingHigh2 and rejWickDominated and rejHighConfirmed

if rejectionSwingLow
    label.new(bar_index[1], c2_low, "Rej ▲", style = label.style_label_up, color = color.new(color.lime, 0), textcolor = color.black, size = size.tiny, yloc = yloc.belowbar)

if rejectionSwingHigh
    label.new(bar_index[1], c2_high, "Rej ▼", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny, yloc = yloc.abovebar)

// =======================================================================
// 2) CLASSIC THREE-BAR EXTREMITY SWING (fractal), also on the MIDDLE bar
// =======================================================================
classicLowCond  = strictClassic ? (low[1]  < low[2]  and low[1]  < low)  : (low[1]  <= low[2]  and low[1]  <= low)
classicHighCond = strictClassic ? (high[1] > high[2] and high[1] > high) : (high[1] >= high[2] and high[1] >= high)

classicSwingLow  = showClassic and classicLowCond
classicSwingHigh = showClassic and classicHighCond

plotshape(classicSwingLow,  title = "Classic Swing Low",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.blue, 0),   size = size.tiny, offset = -1)
plotshape(classicSwingHigh, title = "Classic Swing High", style = shape.triangledown, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny, offset = -1)

// =======================================================================
// 3) MARKET STRUCTURE — BOS / ChoCH
//    Track the most recent unbroken structural swing high/low (sourced
//    from classic or rejection pivots per input) and prevailing bias.
// =======================================================================
var float activeHighPrice = na
var int   activeHighBar   = na
var float activeLowPrice  = na
var int   activeLowBar    = na
var string bias = "undefined"   // "undefined" | "bullish" | "bearish"

pivotHighNow = pivotSourceIsClassic ? classicSwingHigh : rejectionSwingHigh
pivotLowNow  = pivotSourceIsClassic ? classicSwingLow  : rejectionSwingLow
pivotHighPrice = pivotSourceIsClassic ? c2_high : c2_high
pivotLowPrice  = pivotSourceIsClassic ? c2_low  : c2_low
pivotBarIdx    = bar_index[1]

if pivotHighNow
    activeHighPrice := pivotHighPrice
    activeHighBar   := pivotBarIdx

if pivotLowNow
    activeLowPrice := pivotLowPrice
    activeLowBar   := pivotBarIdx

breakLevelHigh = bodyCloseBreak ? close : high
breakLevelLow  = bodyCloseBreak ? close : low

brokeAbove = showStructure and not na(activeHighPrice) and activeHighBar < bar_index and breakLevelHigh > activeHighPrice
brokeBelow = showStructure and not na(activeLowPrice)  and activeLowBar  < bar_index and breakLevelLow  < activeLowPrice

if brokeAbove
    bool isChoch = bias == "bearish" or bias == "undefined"
    label.new(bar_index, high, isChoch ? "ChoCH ▲" : "BOS ▲", style = label.style_label_down, color = color.new(color.teal, 0), textcolor = color.white, size = size.small)
    bias := "bullish"
    activeHighPrice := na
    activeHighBar := na

if brokeBelow
    bool isChoch = bias == "bullish" or bias == "undefined"
    label.new(bar_index, low, isChoch ? "ChoCH ▼" : "BOS ▼", style = label.style_label_up, color = color.new(color.maroon, 0), textcolor = color.white, size = size.small)
    bias := "bearish"
    activeLowPrice := na
    activeLowBar := na

// =======================================================================
// 4) RISK MANAGEMENT — draw SL / TP from the most recent confirmed swing
// =======================================================================
var line slLine = na
var line tpLine = na
var line enLine = na
var label slLabel = na
var label tpLabel = na

if showRisk and (rejectionSwingLow or classicSwingLow)
    float swingPrice = rejectionSwingLow ? c2_low : low[1]
    float buffer = math.max(atrVal * atrBufferMult, swingPrice * pctBuffer)
    float sl = swingPrice - buffer
    float entry = rejectionSwingLow ? c2_bodyTop : math.max(open[1], close[1])
    float slDist = entry - sl
    float tp = entry + slDist * riskReward

    line.delete(slLine)
    line.delete(tpLine)
    line.delete(enLine)
    label.delete(slLabel)
    label.delete(tpLabel)

    slLine := line.new(bar_index[1], sl, bar_index + 10, sl, color = color.red, style = line.style_dashed)
    tpLine := line.new(bar_index[1], tp, bar_index + 10, tp, color = color.green, style = line.style_dashed)
    enLine := line.new(bar_index[1], entry, bar_index + 10, entry, color = color.gray, style = line.style_dotted)
    slLabel := label.new(bar_index + 10, sl, "SL " + str.tostring(sl, format.mintick), style = label.style_label_left, color = color.new(color.red, 80), textcolor = color.red, size = size.tiny)
    tpLabel := label.new(bar_index + 10, tp, "TP " + str.tostring(tp, format.mintick), style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.green, size = size.tiny)

if showRisk and (rejectionSwingHigh or classicSwingHigh)
    float swingPrice = rejectionSwingHigh ? c2_high : high[1]
    float buffer = math.max(atrVal * atrBufferMult, swingPrice * pctBuffer)
    float sl = swingPrice + buffer
    float entry = rejectionSwingHigh ? c2_bodyBottom : math.min(open[1], close[1])
    float slDist = sl - entry
    float tp = entry - slDist * riskReward

    line.delete(slLine)
    line.delete(tpLine)
    line.delete(enLine)
    label.delete(slLabel)
    label.delete(tpLabel)

    slLine := line.new(bar_index[1], sl, bar_index + 10, sl, color = color.red, style = line.style_dashed)
    tpLine := line.new(bar_index[1], tp, bar_index + 10, tp, color = color.green, style = line.style_dashed)
    enLine := line.new(bar_index[1], entry, bar_index + 10, entry, color = color.gray, style = line.style_dotted)
    slLabel := label.new(bar_index + 10, sl, "SL " + str.tostring(sl, format.mintick), style = label.style_label_left, color = color.new(color.red, 80), textcolor = color.red, size = size.tiny)
    tpLabel := label.new(bar_index + 10, tp, "TP " + str.tostring(tp, format.mintick), style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.green, size = size.tiny)

// ---------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------
alertcondition(rejectionSwingLow,  title = "Rejection Swing Low",  message = "3-Bar Rejection Swing Low confirmed")
alertcondition(rejectionSwingHigh, title = "Rejection Swing High", message = "3-Bar Rejection Swing High confirmed")
alertcondition(classicSwingLow,    title = "Classic Swing Low",    message = "Classic 3-Bar Swing Low")
alertcondition(classicSwingHigh,   title = "Classic Swing High",   message = "Classic 3-Bar Swing High")
alertcondition(brokeAbove,         title = "Bullish Structure Break", message = "Bullish BOS/ChoCH")
alertcondition(brokeBelow,         title = "Bearish Structure Break", message = "Bearish BOS/ChoCH")
